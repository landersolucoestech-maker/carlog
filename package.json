{
  "name": "carlog",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10",
  "scripts": {
    "typecheck:core": "tsc -p tsconfig.core.json",
    "test:core": "node scripts/link-core-runtime.mjs && node --test tests/core.test.mjs",
    "check:core": "npm run typecheck:core && npm run test:core",
    "audit:architecture": "node scripts/architecture-audit.mjs",
    "build:packages": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck:packages": "pnpm -r --filter \"./packages/**\" run typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
